@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-contenedor">
    <div class="tarjeta login-tarjeta">
        <div class="login-icono"><i class="bi bi-shield-lock"></i></div>
        <h1 class="h4 text-center titulo-pagina">Iniciar sesión</h1>
        <p class="text-center subtitulo mb-4">Ingresa tus datos para continuar</p>

        @if (ViewBag.Aviso != null)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Aviso
            </div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="NombreUsuario" class="form-control" autofocus />
                </div>
                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input asp-for="Password" class="form-control" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-app w-100 py-2">Entrar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
