@model Usuario
@{
    ViewData["Title"] = "Detalle de usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="tarjeta text-center">
            <span class="avatar mb-3" style="width:72px;height:72px;font-size:1.8rem">@Model.Nombre.Substring(0, 1).ToUpper()</span>
            <h1 class="h4 titulo-pagina">@Model.Nombre</h1>
            <p class="subtitulo">@@@Model.NombreUsuario</p>

            <ul class="list-group list-group-flush text-start my-4">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="subtitulo"><i class="bi bi-envelope me-2"></i>Correo</span>
                    <span>@Model.Correo</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="subtitulo"><i class="bi bi-calendar3 me-2"></i>Fecha de creación</span>
                    <span>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                </li>
            </ul>

            <div class="d-flex justify-content-center gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-app"><i class="bi bi-pencil me-1"></i>Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
