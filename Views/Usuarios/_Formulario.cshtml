@model UsuarioFormViewModel
@* parcial con los campos del form, la usan Create y Edit asi no repito (DRY) *@

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Correo" class="form-label"></label>
    <input asp-for="Correo" class="form-control" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="NombreUsuario" class="form-label"></label>
    <input asp-for="NombreUsuario" class="form-control" />
    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Password" class="form-label"></label>
    <input asp-for="Password" class="form-control" autocomplete="new-password" />
    @if (Model.Id != 0)
    {
        <div class="form-text">Déjala vacía si no la quieres cambiar.</div>
    }
    <span asp-validation-for="Password" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ConfirmarPassword" class="form-label"></label>
    <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
    <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
</div>
