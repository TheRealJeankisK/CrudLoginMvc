@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina"><i class="bi bi-pencil-square me-2"></i>Editar usuario</h1>
            <p class="subtitulo mb-4">Modifica los datos de <strong>@Model.NombreUsuario</strong></p>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <partial name="_Formulario" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app"><i class="bi bi-check-lg me-1"></i>Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
