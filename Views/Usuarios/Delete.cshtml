@model Usuario
@{
    ViewData["Title"] = "Eliminar usuario";
}

<h1 class="h3 mb-3">Eliminar usuario</h1>
<div class="alert alert-danger">¿Seguro que quieres eliminar a <strong>@Model.NombreUsuario</strong>? Esta acción no se puede deshacer.</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
</dl>

@* el borrado va por POST, un link GET nunca deberia borrar *@
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
