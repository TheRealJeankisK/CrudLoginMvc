@model Usuario
@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="tarjeta text-center">
            <div class="login-icono" style="background:#fee2e2;color:#dc2626"><i class="bi bi-trash"></i></div>
            <h1 class="h4 titulo-pagina">Eliminar usuario</h1>
            <p class="subtitulo mb-4">
                ¿Seguro que quieres eliminar a <strong>@Model.NombreUsuario</strong>?<br />Esta acción no se puede deshacer.
            </p>

            <ul class="list-group list-group-flush text-start mb-4">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="subtitulo">Nombre</span><span>@Model.Nombre</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="subtitulo">Correo</span><span>@Model.Correo</span>
                </li>
            </ul>

            @* aqui el borrado va por POST (un link GET nunca deberia borrar) *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Sí, eliminar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
