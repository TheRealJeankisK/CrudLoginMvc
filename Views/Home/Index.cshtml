@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-5">Gestión de Usuarios</h1>
    <p>CRUD de usuarios con login hecho en ASP.NET Core MVC</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-primary">Ir a usuarios</a>
    }
    else
    {
        <a asp-controller="Cuenta" asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
    }
</div>
