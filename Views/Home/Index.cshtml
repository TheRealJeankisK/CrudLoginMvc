@{
    ViewData["Title"] = "Inicio";
}

<div class="tarjeta portada">
    <div class="login-icono"><i class="bi bi-people-fill"></i></div>
    <h1 class="display-6 fw-semibold">Gestión de Usuarios</h1>
    <p class="subtitulo mb-4">CRUD de usuarios con login hecho en ASP.NET Core MVC</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-app btn-lg px-4">
            <i class="bi bi-arrow-right-circle me-1"></i>Ir a usuarios
        </a>
    }
    else
    {
        <a asp-controller="Cuenta" asp-action="Login" class="btn btn-app btn-lg px-4">
            <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
        </a>
    }
</div>
